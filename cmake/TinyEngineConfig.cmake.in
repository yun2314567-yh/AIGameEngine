@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
if(@TINYENGINE_ENABLE_GLFW@ OR @TINYENGINE_ENABLE_MINIAUDIO@)
    find_dependency(Threads)
endif()
if(@TINYENGINE_ENABLE_VULKAN@)
    find_dependency(Vulkan)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/TinyEngineTargets.cmake")
check_required_components(TinyEngine)
